{
  "opencollection": "1.0.0",
  "info": {
    "name": "Liveblocks REST Active Users Storage API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Storage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get storage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.liveblocks.io/v2/rooms/:roomId/storage",
            "params": [
              {
                "name": "roomId",
                "value": "",
                "type": "path",
                "description": "The room identifier."
              }
            ]
          },
          "docs": "Retrieve a room's storage document."
        },
        {
          "info": {
            "name": "Initialize storage",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.liveblocks.io/v2/rooms/:roomId/storage",
            "params": [
              {
                "name": "roomId",
                "value": "",
                "type": "path",
                "description": "The room identifier."
              }
            ]
          },
          "docs": "Initialize storage"
        },
        {
          "info": {
            "name": "Clear storage",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.liveblocks.io/v2/rooms/:roomId/storage",
            "params": [
              {
                "name": "roomId",
                "value": "",
                "type": "path",
                "description": "The room identifier."
              }
            ]
          },
          "docs": "Clear storage"
        },
        {
          "info": {
            "name": "Patch storage with JSON Patch",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.liveblocks.io/v2/rooms/:roomId/storage/json-patch",
            "params": [
              {
                "name": "roomId",
                "value": "",
                "type": "path",
                "description": "The room identifier."
              }
            ]
          },
          "docs": "Patch storage with JSON Patch"
        }
      ]
    }
  ],
  "bundled": true
}